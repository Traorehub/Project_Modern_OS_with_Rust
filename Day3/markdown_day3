## Partie 1 — Bootloader (Boot Sector ASM)

### Objectif

Créer un boot sector en assembleur x86 qui est reconnu par le BIOS et chargé par QEMU comme une vraie image disque.

### Concept

Quand un PC démarre, le BIOS cherche un secteur de 512 octets sur le disque qui se termine par la signature `0xAA55`. C'est le **boot sector**. Il est chargé à l'adresse `0x7C00` en mémoire et exécuté directement par le CPU.

### Fichier `src/boot.asm`

```nasm
BITS 16
ORG 0x7C00

start:
    cli
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7C00

    ; Afficher message de boot
    mov si, msg_boot
    call print16

    ; Charger le kernel depuis le disque
    ; On lit 32 secteurs depuis le secteur 2
    ; et on les place à l'adresse 0x8000
    mov ax, 0x0800       ; segment 0x0800 = adresse 0x8000
    mov es, ax
    xor bx, bx           ; offset 0

    mov ah, 0x02         ; fonction BIOS : lire secteurs
    mov al, 32           ; nombre de secteurs à lire
    mov ch, 0            ; cylindre 0
    mov cl, 2            ; secteur 2 (le kernel commence ici)
    mov dh, 0            ; tête 0
    int 0x13             ; appel BIOS disque

    ; Vérifier si la lecture a réussi
    jc disk_error

    mov si, msg_ok
    call print16

    ; Passer en mode protégé 32 bits
    lgdt [gdt_descriptor]
    mov eax, cr0
    or eax, 1
    mov cr0, eax
    jmp 0x08:protected_mode

disk_error:
    mov si, msg_err
    call print16
    hlt

print16:
    lodsb
    or al, al
    jz print16_done
    mov ah, 0x0E
    int 0x10
    jmp print16
print16_done:
    ret

msg_boot db 'Booting kernel...', 0x0D, 0x0A, 0
msg_ok   db 'Kernel loaded!', 0x0D, 0x0A, 0
msg_err  db 'Disk error!', 0x0D, 0x0A, 0

gdt_start:
    dq 0                     ; descripteur nul obligatoire
    dq 0x00CF9A000000FFFF    ; segment code 32 bits
    dq 0x00CF92000000FFFF    ; segment data 32 bits
gdt_end:

gdt_descriptor:
    dw gdt_end - gdt_start - 1
    dd gdt_start

BITS 32
protected_mode:
    ; Initialiser les segments en mode protégé
    mov ax, 0x10
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov esp, 0x90000

    ; Sauter vers le kernel à 0x8000
    call 0x8000

    ; Si le kernel retourne (ne devrait pas)
    hlt

times 510-($-$$) db 0
dw 0xAA55
```

### Explication ligne par ligne des parties clés

| Instruction | Rôle |
|---|---|
| `BITS 16` | Le CPU démarre toujours en mode 16 bits |
| `ORG 0x7C00` | Le BIOS charge le boot sector à cette adresse |
| `cli` | Désactive les interruptions pendant l'init |
| `int 0x13` | Appel BIOS pour lire des secteurs sur le disque |
| `lgdt` | Charge la table de descripteurs (GDT) pour le mode 32 bits |
| `cr0 or 1` | Active le mode protégé 32 bits |
| `jmp 0x08:protected_mode` | Saut long vers le mode 32 bits |
| `call 0x8000` | Saute vers le kernel chargé en mémoire |
| `0xAA55` | Signature obligatoire reconnue par le BIOS |

### Commandes — Compilation du boot sector

```bash
nasm -f bin src/boot.asm -o boot.bin
```

